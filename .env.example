# SemantIQ Runtime Environment Configuration
# Behavioral Evidence Infrastructure for AI Systems

# Runtime mode: development | test | production
NODE_ENV=development
SEMANTIQ_ENV=local
APP_NAME=SemantIQ
APP_VERSION=1.0.0

# Headless HTTP Server & REST API Configuration
SEMANTIQ_HOST=127.0.0.1
SEMANTIQ_PORT=8080
SEMANTIQ_ENABLE_CORS=false
SEMANTIQ_OFFLINE_MODE=true

# Logging & Diagnostic Auditing
LOG_LEVEL=info
LOG_FORMAT=json
LOG_TIMESTAMPS=true
SEMANTIQ_DATA_DIR=.semantiq/local

# Deterministic Evaluation & Reproducibility Seed
SEMANTIQ_DETERMINISTIC_SEED=424242

# Storage & Persistence (Optional - for persistent ledgers)
DATABASE_URL=postgresql://semantiq:semantiq@localhost:5432/semantiq
DATABASE_POOL_SIZE=10
DATABASE_CONNECT_TIMEOUT=5000
DATABASE_STATEMENT_TIMEOUT=10000

# Optional Cache / State Storage
REDIS_URL=redis://localhost:6379

# Security & Redaction Context
REDACT_SECRETS_IN_LOGS=true
ALLOW_UNPREREGISTERED_STUDIES=false
