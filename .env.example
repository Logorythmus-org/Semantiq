# Runtime mode. Required. Local baseline allows development or test only; production is intentionally not supported here.
NODE_ENV=development

# Tech Club local profile. Required. Allowed values: local, test, docker.
TECHCLUB_ENV=local
TECHCLUB_PROFILE=development
APP_NAME=Tech Club
APP_VERSION=0.0.0
API_HOST=127.0.0.1
API_PORT=8080
API_BASE_PATH=/api
LOG_LEVEL=info
LOG_FORMAT=json
LOG_TIMESTAMPS=true
STARTUP_VALIDATION=strict
TECHCLUB_DATA_DIR=.techclub/development
LOCAL_AI_PROVIDER=disabled
GITHUB_INTEGRATION_ENABLED=false
OPENAI_INTEGRATION_ENABLED=false
FEATURE_FLAGS=

# PostgreSQL connection for local development. Required by persistence-ready modules. Example value uses local-only credentials.
DATABASE_URL=postgresql://techclub:techclub@localhost:5432/techclub
DATABASE_POOL_SIZE=10
DATABASE_CONNECT_TIMEOUT=5000
DATABASE_STATEMENT_TIMEOUT=10000
DATABASE_ECHO=false

# Redis connection for local cache/event experiments. Optional until a module explicitly requires it.
REDIS_URL=redis://localhost:6379

# Neo4j graph endpoint and local-only credentials. Optional until graph persistence is enabled.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=techclub-local

# MinIO local object storage endpoint and local-only credentials. Optional until file/object storage is enabled.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=techclub
MINIO_SECRET_KEY=techclub-local

# Optional OpenTelemetry collector endpoint for local experiments. Leave unset to disable export.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
