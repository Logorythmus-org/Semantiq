# Runtime mode for automated local tests.
NODE_ENV=test

# Tech Club test profile.
TECHCLUB_ENV=test
TECHCLUB_PROFILE=test
API_HOST=127.0.0.1
API_PORT=18080
LOG_LEVEL=warn
LOG_FORMAT=json
TECHCLUB_DATA_DIR=.techclub/test
TECHCLUB_NETWORK_DISABLED=true
TEST_DETERMINISTIC=true
LOCAL_AI_PROVIDER=disabled
GITHUB_INTEGRATION_ENABLED=false
OPENAI_INTEGRATION_ENABLED=false
FEATURE_FLAGS=

# Test database URL. Local-only credentials; do not reuse in production.
DATABASE_URL=postgresql://techclub:techclub@localhost:5432/techclub_test
DATABASE_POOL_SIZE=4
DATABASE_CONNECT_TIMEOUT=3000
DATABASE_STATEMENT_TIMEOUT=5000
DATABASE_ECHO=false

# Optional local service URLs used by integration tests when those services are available.
REDIS_URL=redis://localhost:6379
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=techclub-local
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=techclub
MINIO_SECRET_KEY=techclub-local
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
