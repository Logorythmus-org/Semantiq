  "requiredSealsForPublication": [
    "products/semantiq/extraction-manifest.json",
    "Docs/phase-11/PHASE_11_RELEASE_SEAL.md",
    "Docs/phase-12/PHASE_12_PUBLICATION_AUTHORIZATION.json"
  ],
  "disallowedParentPaths": [
    "packages/wallet",
    "packages/civilization-kernel",
    "packages/question-network",
    "apps/",
    "services/",
    "Tech-Club-Architect-Blueprint.md"
  ]
}
