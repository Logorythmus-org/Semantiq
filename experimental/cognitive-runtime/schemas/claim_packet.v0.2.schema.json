{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logorythmus.org/schemas/semantiq/claim-packet/0.2",
  "title": "SemantIQ Structured Multi-Claim Packet v0.2",
  "type": "object",
  "required": [
    "version",
    "domain",
    "claims"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "0.2"
    },
    "domain": {
      "enum": [
        "nba",
        "software",
        "decision"
      ]
    },
    "intent": {
      "enum": [
        "inspect",
        "execute"
      ]
    },
    "input_text": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "subject",
          "predicate",
          "operator",
          "value",
          "evidence_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "predicate": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "operator": {
            "enum": [
              "eq",
              "neq",
              "gt",
              "gte",
              "lt",
              "lte"
            ]
          },
          "value": {
            "type": [
              "string",
              "boolean",
              "integer",
              "number"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
