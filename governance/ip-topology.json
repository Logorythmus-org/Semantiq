{
  "schema_version": "0.1.0",
  "policy_kind": "logical_topology_no_remote_locations",
  "surfaces": [
    {
      "id": "PUBLIC_REPOSITORY",
      "purpose": "Public implementation, contracts, documentation, conformance, and safe fixtures",
      "permitted_classes": ["PUBLIC"],
      "forbidden_classes": ["RESEARCH_PREPUBLICATION", "PROTECTED"],
      "visibility": "PUBLIC",
      "inbound_dependencies": ["PUBLIC_RELEASED_OR_VERSIONED_ARTIFACTS"],
      "outbound_contracts": ["SCHEMA", "API", "PACKAGE", "CAPABILITY_MANIFEST", "EVIDENCE_FORMAT"],
      "build_boundary": "PUBLIC_SOURCE_ONLY",
      "ci_boundary": "NO_RESTRICTED_SOURCE_OR_SECRETS",
      "secrets_policy": "NO_SECRETS_IN_REPOSITORY",
      "contribution_policy": "PUBLIC_REVIEW_AND_PROVENANCE",
      "publication_policy": "NORMAL_PUBLIC_RELEASE_GATES",
      "artifact_export_policy": "PUBLIC_AND_SANITIZED_ONLY",
      "access_control": "PUBLIC_READ_PROTECTED_WRITE",
      "backup_expectation": "HOST_AND_MAINTAINER_RECOVERY"
    },
    {
      "id": "RESEARCH_WORKSPACE",
      "purpose": "Controlled experiments, evaluations, evidence, and promotion review",
      "permitted_classes": ["RESEARCH_PREPUBLICATION"],
      "forbidden_classes": ["PUBLIC_RELEASE_WITHOUT_GATE"],
      "visibility": "RESTRICTED",
      "inbound_dependencies": ["VERSIONED_PUBLIC_CONTRACTS"],
      "outbound_contracts": ["GATED_RESEARCH_EXPORT", "GATED_PROTECTED_PROMOTION"],
      "build_boundary": "INDEPENDENT_FROM_PUBLIC_BUILD",
      "ci_boundary": "RESTRICTED_CI_ONLY",
      "secrets_policy": "ISOLATED_AND_LEAST_PRIVILEGE",
      "contribution_policy": "AUTHORIZED_RESEARCHERS_WITH_PROVENANCE",
      "publication_policy": "EXPLICIT_RESEARCH_TO_PUBLIC_GATE",
      "artifact_export_policy": "SANITIZE_REVIEW_APPROVE",
      "access_control": "LEAST_PRIVILEGE",
      "backup_expectation": "ENCRYPTED_TESTED_RECOVERY"
    },
    {
      "id": "PROTECTED_IMPLEMENTATION",
      "purpose": "Strategically retained implementations and assets",
      "permitted_classes": ["PROTECTED"],
      "forbidden_classes": ["ANONYMOUS_PUBLICATION"],
      "visibility": "RESTRICTED",
      "inbound_dependencies": ["VERSIONED_PUBLIC_CONTRACTS", "APPROVED_RESEARCH_PROMOTION"],
      "outbound_contracts": ["API_RPC", "VERSIONED_SCHEMA", "PLUGIN_INTERFACE", "SIGNED_ARTIFACT"],
      "build_boundary": "RESTRICTED_SOURCE_ONLY",
      "ci_boundary": "PROTECTED_BRANCH_REVIEW_AND_SECURITY_SCAN",
      "secrets_policy": "ISOLATED_AND_LEAST_PRIVILEGE",
      "contribution_policy": "AUTHORIZED_REVIEWED_ONLY",
      "publication_policy": "NO_PUBLIC_IMPLEMENTATION_RELEASE",
      "artifact_export_policy": "CONTRACT_OR_GATED_SANITIZED_EXPORT_ONLY",
      "access_control": "LEAST_PRIVILEGE_MANDATORY_REVIEW",
      "backup_expectation": "ENCRYPTED_TESTED_RECOVERY"
    },
    {
      "id": "HOSTED_ENTERPRISE",
      "purpose": "Optional hosted operations consuming public contracts",
      "permitted_classes": ["PUBLIC", "HOSTED_ENTERPRISE"],
      "forbidden_classes": ["PUBLIC_SOURCE_DEPENDENCY_ON_HOSTED_IMPLEMENTATION"],
      "visibility": "CONTROLLED",
      "inbound_dependencies": ["VERSIONED_PUBLIC_CONTRACTS"],
      "outbound_contracts": ["PUBLIC_API_COMPATIBILITY"],
      "build_boundary": "SEPARATE_RELEASE_CADENCE",
      "ci_boundary": "NO_PUBLIC_CI_DEPENDENCY",
      "secrets_policy": "SERVICE_SECRET_ISOLATION",
      "contribution_policy": "SEPARATE_GOVERNANCE",
      "publication_policy": "SEPARATE_SERVICE_POLICY",
      "artifact_export_policy": "SANITIZED_PUBLIC_CONTRACTS_ONLY",
      "access_control": "SERVICE_LEAST_PRIVILEGE",
      "backup_expectation": "OPERATIONAL_RECOVERY_POLICY"
    },
    {
      "id": "BRAND_CERTIFICATION_GOVERNANCE",
      "purpose": "Controlled brand usage and certification criteria",
      "permitted_classes": ["BRAND_CERTIFICATION"],
      "forbidden_classes": ["IMPLIED_CODE_LICENSE_RIGHTS"],
      "visibility": "CONTROLLED",
      "inbound_dependencies": ["VERSIONED_PUBLIC_EVIDENCE_CONTRACTS"],
      "outbound_contracts": ["PUBLISHED_CRITERIA", "SIGNED_STATUS"],
      "build_boundary": "SEPARATE_FROM_PRODUCT_BUILD",
      "ci_boundary": "NO_PUBLIC_CI_DEPENDENCY",
      "secrets_policy": "SIGNING_KEY_ISOLATION",
      "contribution_policy": "AUTHORIZED_POLICY_REVIEW",
      "publication_policy": "EXPLICIT_BRAND_AUTHORITY_APPROVAL",
      "artifact_export_policy": "VERSIONED_PUBLIC_CRITERIA_AND_STATUS",
      "access_control": "CONTROLLED_AUTHORITY",
      "backup_expectation": "AUDITABLE_POLICY_RECOVERY"
    }
  ],
  "contract_versioning": {
    "dimensions": ["schema", "api", "package", "capability_manifest", "evidence_artifact"],
    "restricted_consumer_compatibility_check_required": true,
    "public_contracts_testable_without_restricted_code": true,
    "public_release_coupled_to_restricted_release": false
  }
}
