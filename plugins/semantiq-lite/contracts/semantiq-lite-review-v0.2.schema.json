{
  "type": "object",
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SourceSnapshot"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ResearchClaim"
      }
    },
    "anchors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvidenceAnchor"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ClaimEvidenceLink"
      }
    },
    "contract": {
      "enum": [
        "semantiq-lite-review/0.2.0"
      ]
    },
    "review_required": {
      "const": true
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "sources",
    "claims",
    "anchors",
    "links",
    "contract",
    "review_required",
    "limitations"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:semantiq-lite-review:0.2.0",
  "$defs": {
    "SourceSnapshot": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "media_type": {
          "enum": [
            "text/plain",
            "text/markdown"
          ]
        },
        "raw_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "text_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "extracted_text": {
          "type": "string"
        },
        "extractor_name": {
          "enum": [
            "semantiq-lite-utf8"
          ]
        },
        "extractor_version": {
          "enum": [
            "0.2.0"
          ]
        },
        "encoding": {
          "enum": [
            "utf-8"
          ]
        },
        "normalization": {
          "enum": [
            "lf-only-v1"
          ]
        },
        "origin": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "source_id",
        "media_type",
        "raw_sha256",
        "text_sha256",
        "extracted_text",
        "extractor_name",
        "extractor_version",
        "encoding",
        "normalization",
        "origin"
      ],
      "additionalProperties": false
    },
    "EvidenceAnchor": {
      "type": "object",
      "properties": {
        "anchor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "anchor_id",
        "source_id",
        "start",
        "end",
        "quote"
      ],
      "additionalProperties": false
    },
    "ResearchClaim": {
      "type": "object",
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "claim_id",
        "text"
      ],
      "additionalProperties": false
    },
    "ClaimEvidenceLink": {
      "type": "object",
      "properties": {
        "link_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "claim_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "anchor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "semantic_support": {
          "enum": [
            "SUPPORTED_BY_SOURCE",
            "PARTIALLY_SUPPORTED",
            "CONTRADICTED",
            "INSUFFICIENT_EVIDENCE",
            "NOT_ASSESSED"
          ]
        },
        "independent_validation": {
          "enum": [
            "NOT_ATTEMPTED",
            "INSUFFICIENT_DATA",
            "PARTIAL",
            "INDEPENDENTLY_VALIDATED"
          ]
        }
      },
      "required": [
        "link_id",
        "claim_id",
        "anchor_id",
        "semantic_support",
        "independent_validation"
      ],
      "additionalProperties": false
    },
    "ValidationErrorRecord": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "LIMIT_EXCEEDED",
            "INVALID_CONTRACT",
            "ANCHOR_MISMATCH",
            "INVALID_ENCODING",
            "PARSE_TIMEOUT",
            "HASH_MISMATCH",
            "DUPLICATE_ID",
            "DANGLING_REFERENCE",
            "INVALID_STATE_TRANSITION",
            "UNSAFE_PATH"
          ]
        },
        "location": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "location"
      ],
      "additionalProperties": false
    },
    "ResourceLimits": {
      "type": "object",
      "properties": {
        "raw_bytes_per_source": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "total_raw_bytes": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "characters_per_source": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "total_characters": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "sources": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "claims": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "anchors": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "quote_characters": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "source_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "request_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "output_bytes": {
          "type": "integer",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "raw_bytes_per_source",
        "total_raw_bytes",
        "characters_per_source",
        "total_characters",
        "sources",
        "claims",
        "anchors",
        "quote_characters",
        "source_seconds",
        "request_seconds",
        "output_bytes"
      ],
      "additionalProperties": false
    }
  }
}
