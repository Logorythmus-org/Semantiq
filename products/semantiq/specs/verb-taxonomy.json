{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "title": "SemantIQ Verb-Centered Behavioral Taxonomy",
  "description": "Canonical taxonomy classifying AI agent observable behaviors across 7 verb families.",
  "families": [
    "generative",
    "observational",
    "cognitive",
    "operational",
    "communicative",
    "coordinative",
    "protective_and_recovery"
  ],
  "verbs": [
