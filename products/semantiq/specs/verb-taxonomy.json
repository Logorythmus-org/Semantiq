      "name": "Generate Content",
      "family": "generative",
      "definition": "Produce new text, code, or structured assets from scratch or prompt guidance.",
      "preconditions": ["Valid prompt context"],
      "expectedInput": "Prompt string or context record",
      "expectedOutput": "Generated text or asset buffer",
      "affectedResourceTypes": ["memory"],
      "requiredPermissionClasses": ["read_only"],
      "reversibility": "reversible",
      "externalSideEffectPotential": "none",
      "defaultRiskClass": "none",
      "evidenceRequirements": ["output_hash", "token_count"],
      "allowedAliases": ["create_content", "produce_text"],
      "prohibitedAmbiguousAliases": ["do_work", "make_stuff"],
      "exampleEvents": ["Generated summary of scientific paper."],
      "nonExamples": ["Wrote file to local disk."]
    },
    {
      "identifier": "compose",
