{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConstitutionalPrinciples",
  "type": "object",
  "required": ["version", "principles"],
  "properties": {
    "version": { "type": "string" },
    "principles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
