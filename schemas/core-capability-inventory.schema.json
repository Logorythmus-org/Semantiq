            "CURRENT_IMPLEMENTATION",
            "PARTIAL_DESCENDANT",
            "STILL_RELEVANT_RESEARCH",
            "NEEDS_REDESIGN",
            "OBSOLETE_OR_LOW_PRIORITY",
            "INSUFFICIENT_EVIDENCE"
          ]
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
