          "enum": ["IMPLEMENTED", "PARTIAL", "DESIGNED", "ABSENT"]
        }
      },
      "additionalProperties": true
    },
    "human": {
      "type": "object",
      "required": ["component_id", "evidence", "limitation", "role", "status"],
      "properties": {
        "component_id": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "limitation": {
          "type": "string"
        },
        "role": {
          "enum": ["HUMAN_AS_JUDGE", "HUMAN_AS_SUBJECT", "HUMAN_AI_COMPARISON"]
        },
        "status": {
          "enum": [
            "IMPLEMENTED",
            "PARTIAL",
            "SCAFFOLDED",
            "DOCUMENTED_ONLY",
            "HISTORICAL_ONLY",
            "RESEARCH_CANDIDATE",
            "DEPRECATED",
            "UNKNOWN"
          ]
        }
      },
      "additionalProperties": true
    },
    "science": {
      "type": "object",
      "required": ["dimension", "evidence", "limitation", "status"],
      "properties": {
        "dimension": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "limitation": {
          "type": "string"
        },
        "status": {
          "enum": ["SUPPORTED", "PARTIAL", "ABSENT", "NOT_APPLICABLE"]
        }
      },
      "additionalProperties": true
    },
    "layer": {
      "type": "object",
      "required": ["layer_id", "name", "gap", "capabilities", "status"],
      "properties": {
        "layer_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "gap": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": ["ALREADY_PRESENT", "PARTIALLY_PRESENT", "MISSING"]
        }
      },
      "additionalProperties": true
