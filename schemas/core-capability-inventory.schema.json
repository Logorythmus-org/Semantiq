          "type": "string"
        },
        "existing_foundation": {
          "type": "string"
        },
        "dependency": {
          "type": "string"
        },
        "research_required": {
          "type": "string"
        },
        "engineering_required": {
          "type": "string"
        },
        "risk": {
          "type": "string"
        },
        "recommended_priority": {
          "type": "string"
        },
        "destination_phase": {
          "type": "string"
        }
