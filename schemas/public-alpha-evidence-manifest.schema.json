{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PublicAlphaEvidenceManifest",
  "type": "object",
  "required": [
    "releaseLevel",
    "status",
    "commit",
    "tag",
    "testFiles",
    "tests",
    "typecheckErrors",
    "criticalInternalBlockers",
    "externalReplication",
    "independentAudit",
    "certification",
    "productionSafetyGuarantee",
    "repository",
    "branch",
    "semanticVersion",
    "nodeVersion",
    "pnpmVersion",
    "operatingSystem",
    "buildEnvironment",
    "timestamp"
  ],
  "properties": {
    "releaseLevel": { "type": "string", "const": "2-public-alpha" },
    "status": { "type": "string", "const": "experimental" },
    "commit": { "type": "string" },
    "tag": { "type": "string" },
    "testFiles": { "type": "integer" },
    "tests": { "type": "integer" },
    "typecheckErrors": { "type": "integer", "const": 0 },
    "criticalInternalBlockers": { "type": "integer", "const": 0 },
    "externalReplication": { "type": "string", "const": "not-yet-established" },
    "independentAudit": { "type": "string", "const": "not-yet-established" },
    "certification": { "type": "boolean", "const": false },
    "productionSafetyGuarantee": { "type": "boolean", "const": false },
    "repository": { "type": "string" },
    "branch": { "type": "string" },
    "semanticVersion": { "type": "string" },
    "nodeVersion": { "type": "string" },
    "pnpmVersion": { "type": "string" },
    "operatingSystem": { "type": "string" },
    "buildEnvironment": { "type": "string" },
    "timestamp": { "type": "string" }
  }
}
