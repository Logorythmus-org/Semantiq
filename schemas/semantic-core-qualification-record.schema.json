{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "qualificationId": { "const": "semantic_core_pilot_bm3_qualification" },
        "qualificationVersion": { "const": "0.1.0" }
      },
      "required": ["qualificationId", "qualificationVersion"]
    },
    "protocol": { "type": "object" },
    "conditionDigest": { "$ref": "#/$defs/sha" },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "benchmarkId": { "const": "semantic_core_pilot" },
        "benchmarkVersion": { "const": "0.1.0" }
      },
      "required": ["benchmarkId", "benchmarkVersion"]
    },
    "packDigest": { "const": "b173eea32402050aba5989308fdb559b75c17956c2e2a9644ef65212a93a358a" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gitCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "gitTree": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      },
      "required": ["gitCommit", "gitTree"]
    },
    "scheduledRuns": { "const": 3 },
    "scheduledAttempts": { "const": 72 },
    "accountedAttempts": { "type": "integer", "minimum": 0, "maximum": 72 },
    "evaluatorReplayExact": { "type": "boolean" },
    "reliabilityReferences": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "packageId": { "type": "string" },
          "packageDigest": { "$ref": "#/$defs/sha" },
          "outcome": {
            "enum": [
              "VERIFIED_INTERNAL_CONSISTENCY",
              "PARTIALLY_VERIFIED",
              "VERIFICATION_FAILED",
              "INSUFFICIENT_EVIDENCE",
              "NOT_ASSESSED"
            ]
          }
        },
        "required": ["packageId", "packageDigest", "outcome"]
      }
    },
    "regression": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exact": { "type": "boolean" },
        "replayedAttempts": { "type": "integer", "minimum": 0, "maximum": 72 },
        "externalReproduction": { "const": false },
        "scientificAuthority": { "const": "NONE" }
      },
      "required": ["exact", "replayedAttempts", "externalReproduction", "scientificAuthority"]
    },
    "criticalFindings": { "type": "array", "items": { "type": "string" } },
    "exposure": { "const": "TIER_A_PUBLIC_NOT_HELD_OUT_CONTAMINATION_UNKNOWN" },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "repositoryRegression": {
      "enum": ["PENDING_EXTERNAL_VALIDATION", "PASSED_REFERENCED_OPERATOR_REPORT"]
    },
    "repositoryValidation": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "reportDigest": { "$ref": "#/$defs/sha" },
            "status": { "const": "PASSED" }
          },
          "required": ["sourceCommit", "reportDigest", "status"]
        }
      ]
    },
    "outcome": { "enum": ["QUALIFIED_FOR_BM3_REVIEW", "NOT_QUALIFIED", "INSUFFICIENT_EVIDENCE"] },
    "scientificAuthority": { "const": "NONE" },
    "decisionAuthority": { "const": "NONE" },
    "proposesBM3": { "const": false },
    "acceptance": { "const": "HUMAN_REVIEW_AND_MERGE_REQUIRED" }
  },
  "required": [
    "identity",
    "protocol",
    "conditionDigest",
    "benchmark",
    "packDigest",
    "source",
    "scheduledRuns",
    "scheduledAttempts",
    "accountedAttempts",
    "evaluatorReplayExact",
    "reliabilityReferences",
    "packages",
    "regression",
    "criticalFindings",
    "exposure",
    "limitations",
    "repositoryRegression",
    "repositoryValidation",
    "outcome",
    "scientificAuthority",
    "decisionAuthority",
    "proposesBM3",
    "acceptance"
  ],
  "allOf": [
    {
      "if": {
        "properties": { "outcome": { "const": "QUALIFIED_FOR_BM3_REVIEW" } },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "accountedAttempts": { "const": 72 },
          "evaluatorReplayExact": { "const": true },
          "criticalFindings": { "type": "array", "maxItems": 0 },
          "repositoryRegression": { "const": "PASSED_REFERENCED_OPERATOR_REPORT" },
          "repositoryValidation": { "type": "object" }
        }
      }
    }
  ],
  "$defs": { "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
